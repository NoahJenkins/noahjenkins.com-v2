{
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_config_user_agent||'')){console.error('This repository uses pnpm only. Run: pnpm install');process.exit(1)}\"",
    "dev": "next dev --webpack",
    "dev:clean": "pkill -f 'next dev' || true && rm -f .next/dev/lock && pnpm dev",
    "build": "next build --webpack",
    "build:turbo": "next build",
    "start": "next start",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:all": "pnpm test && pnpm test:ui",
    "test:all:ci": "pnpm test -- --passWithNoTests && pnpm test:ui",
    "test:all:clean": "pkill -f 'next dev' || true && pnpm test && pnpm test:ui"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.7",
    "sugar-high": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wavesurfer.js": "^8.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  }
}
